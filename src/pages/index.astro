---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Networking &amp; Programming Notes</h1>
			<p>
				Personal notes on networking and programming — protocols, lab troubleshooting, automation,
				and experiment write-ups.
			</p>
			<ul>
				<li><a href="/blog">Browse posts</a></li>
				<li><a href="/about">About</a></li>
			</ul>

			<h2>Add a new post</h2>
			<ol>
				<li>Create a Markdown file in <code>src/content/blog/</code> (example: <code>my-topic.md</code>).</li>
				<li>
					Add frontmatter at the top:
					<pre><code>---
title: 'Post title'
description: 'One-line summary'
pubDate: 'Aug 30 2026'
tags: ['networking']
---

Write your content here.</code></pre>
				</li>
				<li>Preview locally: <code>npm run dev</code> → open <code>http://localhost:4321</code>.</li>
				<li>Publish: <code>git add</code> → <code>git commit</code> → <code>git push</code> to <code>main</code>.</li>
			</ol>
			<p>The filename becomes the URL, e.g. <code>my-topic.md</code> → <code>/blog/my-topic/</code>.</p>

			<h2>Turn the website on / off</h2>
			<p>
				GitHub Pages controls whether the site is public. Open
				<a href="https://github.com/creisment999/creisment999.github.io/settings/pages" target="_blank" rel="noopener noreferrer"
					>Settings → Pages</a
				>:
			</p>
			<ul>
				<li>
					<strong>On:</strong> set Source to <strong>GitHub Actions</strong>. After a successful
					<code>Deploy to GitHub Pages</code> run, the site is live at
					<a href="https://creisment999.github.io">https://creisment999.github.io</a>.
				</li>
				<li>
					<strong>Off:</strong> change Source away from GitHub Actions (or remove the Pages setup).
					The public URL will stop serving your site.
				</li>
			</ul>
			<p>
				You can also unpublish from the same Pages settings page if GitHub shows an Unpublish
				button.
			</p>
		</main>
		<Footer />
	</body>
</html>

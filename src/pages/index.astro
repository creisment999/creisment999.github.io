---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Networking &amp; Programming Notes</h1>
			<p>
				This site collects what I learn about networking and programming: protocols, lab
				troubleshooting, automation scripts, and postmortems from real experiments.
			</p>
			<p>
				Posts are written in Markdown. I try to capture what I did, why it mattered, and how to
				verify the result — useful for my future self and for anyone reproducing the steps.
			</p>
			<ul>
				<li>Browse posts: <a href="/blog">Blog</a></li>
				<li>About this site: <a href="/about">About</a></li>
				<li>Add a post: create a <code>.md</code> file under <code>src/content/blog/</code></li>
			</ul>
			<p>
				Built with the official <a href="https://astro.build/">Astro</a> blog template — minimal,
				fast, and easy to maintain.
			</p>
		</main>
		<Footer />
	</body>
</html>
